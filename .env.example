# Arbitrum Sepolia RPC endpoint used by Foundry and the dashboard
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
ARBITRUM_SEPOLIA_WS_URL=
SHIELDED_SOLVER_ESCROW_ADDRESS=

# Zcash Testnet Lightwalletd gRPC endpoint (self-host for stronger privacy)
ZCASH_LIGHTWALLETD_URL=http://127.0.0.1:9067
ZCASH_REQUIRED_CONFIRMATIONS=1

# Local Rust relayer REST API base URL (server-side Next.js proxy)
RELAYER_API_URL=http://127.0.0.1:8080

# Optional explorer API key for contract verification
ARBISCAN_API_KEY=
